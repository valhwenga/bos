# Local Supabase stack (npx supabase start prints these as API_URL / ANON_KEY).
# The anon key is a public, RLS-scoped key and is safe in a browser bundle;
# the service_role key is not and must never appear here.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=replace-with-the-anon-key-from-npx-supabase-status
